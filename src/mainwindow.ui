<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1300</width>
    <height>850</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Fleet Management System</string>
  </property>
  <widget class="QWidget" name="centralwidget">
   <property name="styleSheet">
    <string notr="true">
    QWidget {
      background-color: #ffffff;
    }
    QPushButton {
      border-radius: 5px;
      padding: 4px 8px;
      min-height: 17px;
      font-size: 10pt;
    }

    /* Vehicle buttons: cyan */
    #createDroneButton, #createVanButton, #createRobotButton,
    #setStateButton, #deliverButton {
      background-color: #c1eaed;
      color: #2c3e50;
    }
    #createDroneButton:hover, #createVanButton:hover, #createRobotButton:hover,
    #setStateButton:hover, #deliverButton:hover {
      background-color: #9fd6da;
    }
    #createDroneButton:pressed, #createVanButton:pressed, #createRobotButton:pressed,
    #setStateButton:pressed, #deliverButton:pressed {
      background-color: #7fbfc3;
    }

    /* Remove Vehicle button: red */
    #removeVehicleButton {
      background-color: #FF0000;
      color: white;
    }
    #removeVehicleButton:hover { background-color: #c0392b; }
    #removeVehicleButton:pressed { background-color: #922b21; }

    /* Package buttons: gray */
    #createStandardPackageButton, #createFragilePackageButton,
    #createRefrigeratedPackageButton, #createExpressPackageButton,
    #assignPackageButton, #removePackageButton {
      background-color: #b1b1b1;
      color: #2c3e50;
    }
    #createStandardPackageButton:hover, #createFragilePackageButton:hover,
    #createRefrigeratedPackageButton:hover, #createExpressPackageButton:hover,
    #assignPackageButton:hover, #removePackageButton:hover {
      background-color: #999999;
    }
    #createStandardPackageButton:pressed, #createFragilePackageButton:pressed,
    #createRefrigeratedPackageButton:pressed, #createExpressPackageButton:pressed,
    #assignPackageButton:pressed, #removePackageButton:pressed {
      background-color: #777777;
    }

    /* Show Details button: highlighted yellow */
    #showVehicleDetailsButton, #showCompatibilityButton {
      background-color: #fdd907;
      color: #2c3e50;
      font-weight: bold;
    }
    #showVehicleDetailsButton:hover, #showCompatibilityButton:hover { background-color: #e6c800; }
    #showVehicleDetailsButton:pressed, #showCompatibilityButton:pressed { background-color: #bfa300; }

    /* System controls: yellow */
    #refreshButton {
      background-color: #0e689b;
      color: #ffffff;
      font-weight: bold;
    }
    #refreshButton:hover { background-color: #0b4f75; }
    #refreshButton:pressed { background-color: #00476f; }

    /* Table styles */
    QTableWidget {
        gridline-color: #bdc3c7;
        alternate-background-color: #f8f9fa;
    }
    QTableWidget::item {
        padding: 4px;
    }
    QTableWidget::item:selected {
        background-color: #3498db;
        color: white;
    }
    QHeaderView::section {
        background-color: #2c3e50;
        color: white;
        padding: 4px;
        border: 1px solid #34495e;
        font-weight: bold;
    }
    </string>
   </property>
